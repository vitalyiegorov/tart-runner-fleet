# Keeps the npm cache inside its limits (ADR 0093). Install beside its timer in
# ~/.config/systemd/user/, and the script as
# ~/.config/tart-runner-fleet-npm-cache/prune-npm-cache.py. A failed run means it froze the cache,
# or could not, because it could not enforce the limits: read its journal. If it is killed at its
# timeout or never starts, the script cannot act, so OnFailure= freezes the cache from outside.
[Unit]
Description=tart-runner-fleet npm cache limits (ADR 0093)
OnFailure=tart-runner-fleet-npm-cache-freeze.service

[Service]
Type=oneshot
# 40 GiB limit, 32 GiB after eviction, and a reserve of minFreeDiskGb (60) plus 40 GiB.
ExecStart=/usr/bin/python3 -I %h/.config/tart-runner-fleet-npm-cache/prune-npm-cache.py --data %h/.local/share/tart-runner-fleet-npm-cache/data --high-gib 40 --low-gib 32 --reserve-gib 100
TimeoutStartSec=300
Nice=15
IOSchedulingClass=idle
# It can write only to its storage, and it speaks to nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/tart-runner-fleet-npm-cache
PrivateTmp=yes
RestrictAddressFamilies=none
