        "@tailwindcss/postcss": "4.3.5",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "knip": "6.45.1",
        "oxfmt": "0.78.0",
        "oxlint": "1.93.0",
        "oxlint-tsgolint": "7.0.2007",
        "tailwindcss": "4.3.5",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    }
