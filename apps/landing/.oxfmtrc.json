{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "singleQuote": true,
    "printWidth": 140,
    "tabWidth": 4,
    "semi": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "sortImports": {
        "groups": ["builtin", "external", "parent", "sibling", "index", "type", "unknown"],
        "ignoreCase": true,
        "newlinesBetween": true,
        "order": "asc"
    },
    "sortPackageJson": true,
    "ignorePatterns": [".next/**", "test-results/**", "playwright-report/**", "src/app/icon.svg"]
}
