# One quiescence-gated production release check. The `systemd --user`
# equivalent of the updater LaunchAgent internal/autoupdate renders on macOS,
# rendered here by render-systemd.sh so that a Linux node's three units come from
# the release rather than from the running daemon.
#
# This unit is the work; tart-runner-fleet-updater.timer is the schedule. Only
# the timer is enabled, started and re-armed — `fleet update apply-latest` may
# itself be running as this service, and restarting it would terminate the
# update mid-transaction (ADR 0051). `fleet update adopt` installs and enables
# the pair; until a node is adopted, neither is enabled.
[Unit]
Description=tart-runner-fleet forward-only production release check
Documentation=https://github.com/vitalyiegorov/tart-runner-fleet

[Service]
Type=oneshot
ExecStart="__RELEASE_DIR__/fleet" update apply-latest "--repo" "__REPOSITORY__" "--root" "__ROOT__" "--state-dir" "__STATE_DIR__" "--launch-agents-dir" "__UNITS_DIR__" "--mode" "__MODE__" "--config" "__STATE_DIR__/fleet.json" "--endpoint" "__ENDPOINT__" "--domain" "user" "--confirm" "automatic-release-update"
# The updater resolves `gh` on this path. The launchd twin carries Homebrew's
# prefix for the same reason; the XDG user binary directory is the Linux
# analogue for a node whose GitHub CLI is not a distribution package.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:%h/.local/bin
UMask=0077
Nice=10
IOSchedulingClass=idle
StandardOutput=append:__STATE_DIR__/update.stdout.log
StandardError=append:__STATE_DIR__/update.stderr.log
# The updater keeps the sandbox the controller unit had to give up: it forks no
# guest runtime, so nothing under it needs a file capability or a uid map wider
# than this uid (issue #277). It is also the one process on the node that
# unpacks and runs a downloaded artifact, which is the process worth confining.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictSUIDSGID=yes
