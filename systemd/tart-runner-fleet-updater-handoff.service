# The updater's own generation swap, performed by a process the updater is not.
#
# The macOS original exists because a loaded updater may be the very process
# executing the commit, so asking the supervisor to reload it there terminates
# the caller before it can start the replacement. systemd needs no such dance:
# the schedule lives in a separate timer unit, which a commit can re-arm without
# touching the one-shot running it (ADR 0051). What the subcommand does here is
# the assertion the handoff was always for — after a durable commit, require the
# timer to report ActiveState=active.
#
# NOT ENABLED BY DEFAULT. Nothing starts it; it answers a manual invocation.
[Unit]
Description=tart-runner-fleet updater generation handoff
Documentation=https://github.com/vitalyiegorov/tart-runner-fleet
# The handoff retries until the commit it is waiting for is durable, so no start
# rate limit may terminate it early.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart="__RELEASE_DIR__/fleet" update finish-updater-handoff "--repo" "__REPOSITORY__" "--root" "__ROOT__" "--state-dir" "__STATE_DIR__" "--launch-agents-dir" "__UNITS_DIR__" "--mode" "__MODE__" "--config" "__STATE_DIR__/fleet.json" "--endpoint" "__ENDPOINT__" "--domain" "user" "--release-dir" "__RELEASE_DIR__" "--interval" "__INTERVAL__" "--confirm" "automatic-updater-handoff"
# The updater resolves `gh` on this path. The launchd twin carries Homebrew's
# prefix for the same reason; the XDG user binary directory is the Linux
# analogue for a node whose GitHub CLI is not a distribution package.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:%h/.local/bin
# KeepAlive{SuccessfulExit:false} with a ten-second throttle.
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
IOSchedulingClass=idle
StandardOutput=append:__STATE_DIR__/update.stdout.log
StandardError=append:__STATE_DIR__/update.stderr.log
# Sandboxed for the same reason as tart-runner-fleet-updater.service, and safe
# to sandbox for the same reason: the generation swap forks no guest runtime
# (issue #277).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictSUIDSGID=yes
