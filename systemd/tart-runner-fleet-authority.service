# tart-runner-fleet controller, observe mode. The `systemd --user` equivalent of
# com.vitalyiegorov.tart-runner-fleet.plist, rendered by render-systemd.sh.
#
# Every argument is quoted because a release directory may contain spaces and
# systemd splits an unquoted ExecStart on whitespace. render-systemd.sh refuses
# any path carrying a quote, a backslash, a dollar sign, or a percent sign, so
# the quoting cannot be escaped and no systemd specifier can be smuggled in.
[Unit]
Description=tart-runner-fleet controller (authority)
Documentation=https://github.com/vitalyiegorov/tart-runner-fleet
# The daemon supervises ephemeral CI runners and is expected to restart for as
# long as the machine is up, so no start-rate limit may ever wedge it off.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="__RELEASE_DIR__/fleet" run "--mode=authority" "--config=__STATE_DIR__/fleet.json" "--database=__STATE_DIR__/fleet.db" "--admin-socket=__STATE_DIR__/fleetd.sock" "--health-address=127.0.0.1:9876"
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# KeepAlive{SuccessfulExit:false}: a clean exit is an operator stopping the
# daemon, and only a failure is restarted.
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
# AbandonProcessGroup: the supervisor stops the controller, never the guest
# processes it has already handed work to.
KillMode=process
UMask=0077
Nice=5
IOSchedulingClass=idle
StandardOutput=append:__STATE_DIR__/fleet.stdout.log
StandardError=append:__STATE_DIR__/fleet.stderr.log
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
# ProtectProc and ProcSubset are deliberately NOT set: the host probe reads
# /proc/meminfo, /proc/vmstat, /proc/stat and /proc/loadavg, and hiding them
# would turn every admission decision into an unavailable observation.

[Install]
WantedBy=default.target
