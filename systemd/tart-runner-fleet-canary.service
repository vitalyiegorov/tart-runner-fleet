# tart-runner-fleet controller, observe mode. The `systemd --user` equivalent of
# com.vitalyiegorov.tart-runner-fleet.plist, rendered by render-systemd.sh.
#
# Every argument is quoted because a release directory may contain spaces and
# systemd splits an unquoted ExecStart on whitespace. render-systemd.sh refuses
# any path carrying a quote, a backslash, a dollar sign, or a percent sign, so
# the quoting cannot be escaped and no systemd specifier can be smuggled in.
[Unit]
Description=tart-runner-fleet controller (canary)
Documentation=https://github.com/vitalyiegorov/tart-runner-fleet
# The daemon supervises ephemeral CI runners and is expected to restart for as
# long as the machine is up, so no start-rate limit may ever wedge it off.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="__RELEASE_DIR__/fleet" run "--mode=canary" "--canary-scope=__CANARY_SCOPE__" "--canary-profile=__CANARY_PROFILE__" "--config=__STATE_DIR__/fleet.json" "--database=__STATE_DIR__/fleet-canary.db" "--admin-socket=__STATE_DIR__/fleet-canary.sock" "--health-address=127.0.0.1:9878"
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# KeepAlive{SuccessfulExit:false}: a clean exit is an operator stopping the
# daemon, and only a failure is restarted.
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
# AbandonProcessGroup: the supervisor stops the controller, never the guest
# processes it has already handed work to.
KillMode=process
UMask=0077
Nice=5
IOSchedulingClass=idle
StandardOutput=append:__STATE_DIR__/fleet.stdout.log
StandardError=append:__STATE_DIR__/fleet.stderr.log
# This unit is deliberately not sandboxed, for two unrelated reasons.
#
# NoNewPrivileges, PrivateTmp, ProtectSystem, ProtectKernelTunables and
# RestrictSUIDSGID: the controller forks the node's execution technology, which
# on Linux is rootless podman, and podman execs /usr/bin/newuidmap
# (cap_setuid=ep) to write a subuid map. NoNewPrivileges, and RestrictSUIDSGID
# which implies it, make that execve acquire no file capability at all; the
# three namespacing directives make an unprivileged `systemd --user` manager
# build their mount namespace inside a user namespace whose uid map holds this
# uid alone, leaving no subuid to map. Either way podman cannot create its pause
# process and the node never reaches ready (issue #277).
#
# ProtectProc and ProcSubset: the host probe reads /proc/meminfo, /proc/vmstat,
# /proc/stat and /proc/loadavg, and hiding them would turn every admission
# decision into an unavailable observation.

[Install]
WantedBy=default.target
